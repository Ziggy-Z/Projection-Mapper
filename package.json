{
  "name": "projection-mapper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Single-projector wall-installation mapping tool",
  "author": "Ziggy-Z",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron dist-electron/electron/main.js",
    "package": "npm run build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
