{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "noEmit": false,
    "rootDir": "..",
    "outDir": "../dist-electron",
    "types": ["node"]
  },
  "include": ["**/*.ts", "../src/model/desktop.ts"]
}
